# Used by docker-compose.yml. Copy to .env and fill in.
# Generate secrets with: openssl rand -base64 48
JWT_SECRET=
FILE_URL_SECRET=
DB_PASSWORD=fixlocal
APP_URL=http://localhost:8080
WEB_PORT=8080
# true when served over HTTPS
COOKIE_SECURE=false
# Email: these defaults print emails to the API log so a local `docker compose up` works out of the box.
# For a real deployment set MAIL_PROVIDER=smtp, SMTP_URL=smtps://user:pass@smtp.example.com:465
# and ALLOW_CONSOLE_MAIL=false.
MAIL_PROVIDER=console
SMTP_URL=
MAIL_FROM=FixLocal <no-reply@example.com>
ALLOW_CONSOLE_MAIL=true
# Proxies in front of the API: 1 = only the bundled nginx; 2 = an outer TLS proxy/load balancer + nginx.
TRUST_PROXY=1
# Interface the web container listens on (127.0.0.1 = this machine only).
WEB_BIND=127.0.0.1
# Backups (`docker compose --profile backup up -d`): days to keep, and where to write them
# (a volume name or an absolute host path, ideally a disk that is not this server's).
BACKUP_KEEP_DAYS=14
BACKUP_PATH=db_backups
# Optional: POST a JSON payload here for every 500 / unhandled rejection (Slack, Discord, Sentry relay …)
ERROR_WEBHOOK_URL=
# Optional: a map tile provider with a production usage policy
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
# Public site origin for sitemap.xml, robots.txt and Open Graph tags, e.g. https://fixlocal.in
# (empty = APP_URL)
VITE_SITE_URL=
# Shown on /terms and /privacy. Indian IT Rules require a named Grievance Officer with contact details.
VITE_LEGAL_ENTITY=
VITE_SUPPORT_EMAIL=
VITE_GRIEVANCE_OFFICER=
VITE_GRIEVANCE_EMAIL=
