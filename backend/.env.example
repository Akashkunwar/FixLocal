# ---- server ----
PORT=3001
NODE_ENV=development
# Set to true behind a reverse proxy (so rate limits see the real client IP)
TRUST_PROXY=false
LOG_LEVEL=info

# ---- database (schema is managed by migrations: npm run db:migrate) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fixlocal
DB_PASSWORD=fixlocal
DB_NAME=fixlocal
DB_LOGGING=false
# Apply pending migrations automatically at startup (otherwise the server refuses to start)
MIGRATIONS_RUN=false

# ---- auth ----
# Production: at least 32 random characters each (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-in-production
FILE_URL_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Cookies: set COOKIE_SECURE=true on HTTPS. Use COOKIE_SAMESITE=none only if the API is on a different site.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used in email links
APP_URL=http://localhost:5173

# ---- local development helpers (ignored in production) ----
# Skip email verification for new accounts
DEV_AUTO_VERIFY_EMAIL=false
# Expose GET /api/dev/outbox with the last emails the console mailer "sent"
DEV_OUTBOX=false

# ---- email ----
# console = print emails to the log (development only). Production needs smtp, e.g.
# SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
MAIL_PROVIDER=console
SMTP_URL=
MAIL_FROM=FixLocal <no-reply@example.com>
# Only for a private test deployment that can live without email delivery:
ALLOW_CONSOLE_MAIL=false

# ---- error tracking (optional) ----
# Every 500 and unhandled rejection is POSTed here as JSON (Slack/Discord webhook, Sentry relay, …)
ERROR_WEBHOOK_URL=

# ---- uploads ----
# local = files on this host under UPLOADS_DIR (one server). s3 = any S3-compatible bucket
# (AWS S3, Cloudflare R2, Backblaze B2, MinIO); use it once more than one API instance runs.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
# S3_BUCKET=fixlocal-uploads
# S3_REGION=ap-south-1            # "auto" for Cloudflare R2
# S3_ENDPOINT=                    # e.g. https://<account>.r2.cloudflarestorage.com; empty for AWS
# S3_ACCESS_KEY_ID=               # leave both empty to use the instance role / AWS default chain
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false       # true for MinIO
# S3_PREFIX=                      # optional key prefix, e.g. uploads/

# ---- Redis (optional: caching, rate limits, live updates across instances) ----
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_ENABLED=true

# ---- background jobs ----
WORKERS_ENABLED=true
WORKER_INTERVAL_SEC=60
# Days before a job marked done by the pro is confirmed automatically
AUTO_CONFIRM_DAYS=3
# Open jobs with nobody hired close after this many days (reminder 3 days before).
JOB_EXPIRY_DAYS=30
QUOTE_VIEW_NUDGE_HOURS=4

# ---- seed data (npm run seed) ----
# Demo accounts: admin@ / home@ / home2@ / pro@ / pro2@ / pro3@fixlocal.local
SEED_PASSWORD=Password123!
# Reset existing demo accounts' passwords to SEED_PASSWORD
SEED_RESET=false

# Referral credit (simulated, like escrow). 0 switches rewards off.
REFERRAL_REWARD_INR=100
REFERRAL_MONTHLY_CAP=10
REFERRAL_MIN_JOB_INR=500

# SMS / WhatsApp alerts (see docs/OPERATIONS.md). Off by default; "log" drivers send nothing.
MESSAGING_ENABLED=false
SMS_DRIVER=log
WHATSAPP_DRIVER=log
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=fixlocal_update
WHATSAPP_API_VERSION=v21.0
