PORT=3001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fixlocal
DB_PASSWORD=fixlocal
DB_NAME=fixlocal

JWT_SECRET=change-me-in-production

# Seed demo accounts (npm run seed):
#   admin@fixlocal.local  — ADMIN
#   home@fixlocal.local   — HOMEOWNER
#   pro@fixlocal.local    — TRADESPERSON
# Password for all seed users:
SEED_PASSWORD=Password123!

# Optional Redis cache for open-job list (TTL 60s; invalidated on create/accept/cancel)
# brew services start redis
# Or: docker run -p 6379:6379 -d redis:7
REDIS_URL=redis://127.0.0.1:6379
# Set to false to force skip Redis even if installed:
# REDIS_ENABLED=false
