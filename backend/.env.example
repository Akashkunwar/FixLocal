# ---- server ----
PORT=3001
NODE_ENV=development
# Set to true behind a reverse proxy (so rate limits see the real client IP)
TRUST_PROXY=false
LOG_LEVEL=info

# ---- database (schema is managed by migrations: npm run db:migrate) ----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fixlocal
DB_PASSWORD=fixlocal
DB_NAME=fixlocal
DB_LOGGING=false
# Apply pending migrations automatically at startup (otherwise the server refuses to start)
MIGRATIONS_RUN=false

# ---- auth ----
# Production: at least 32 random characters each (e.g. `openssl rand -base64 48`)
JWT_SECRET=change-me-in-production
FILE_URL_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Cookies: set COOKIE_SECURE=true on HTTPS. Use COOKIE_SAMESITE=none only if the API is on a different site.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Used in email links
APP_URL=http://localhost:5173

# ---- local development helpers (ignored in production) ----
# Skip email verification for new accounts
DEV_AUTO_VERIFY_EMAIL=false
# Expose GET /api/dev/outbox with the last emails the console mailer "sent"
DEV_OUTBOX=false

# ---- uploads ----
UPLOADS_DIR=uploads

# ---- Redis (optional: caching, rate limits, live updates across instances) ----
REDIS_ENABLED=true
REDIS_URL=redis://127.0.0.1:6379
RATE_LIMIT_ENABLED=true

# ---- background jobs ----
WORKERS_ENABLED=true
WORKER_INTERVAL_SEC=60
# Days before a job marked done by the pro is confirmed automatically
AUTO_CONFIRM_DAYS=3
QUOTE_VIEW_NUDGE_HOURS=4

# ---- seed data (npm run seed) ----
# Demo accounts: admin@ / home@ / home2@ / pro@ / pro2@ / pro3@fixlocal.local
SEED_PASSWORD=Password123!
# Reset existing demo accounts' passwords to SEED_PASSWORD
SEED_RESET=false
