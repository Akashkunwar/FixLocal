{
  "name": "fixlocal-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:tz": "TZ=UTC vitest run test/unit && TZ=Asia/Kolkata vitest run test/unit && TZ=America/Los_Angeles vitest run test/unit",
    "typeorm": "tsx ./node_modules/typeorm/cli.js -d src/data-source.ts",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d src/data-source.ts",
    "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create",
    "db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "db:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "db:baseline": "tsx src/scripts/baseline.ts",
    "seed": "tsx src/scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run seed",
    "db:reset-e2e": "tsx src/scripts/resetDb.ts",
    "e2e:server": "tsx src/scripts/resetDb.ts && tsx src/scripts/seed.ts && tsx src/server.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.4",
    "typeorm": "^0.3.20",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "typeorm": {
      "redis": "$redis"
    }
  }
}
