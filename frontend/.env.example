# Leave empty to call the API on the same origin (the Vite dev server proxies /api).
# Set it only if the API is served from a different site (requires COOKIE_SAMESITE=none on the API).
VITE_API_URL=
# Where the dev/preview server forwards /api requests
VITE_PROXY_TARGET=http://localhost:3001
VITE_PORT=5173
# Show the demo-account helper on the login page (never enable in production)
VITE_DEMO_MODE=false
# Map tiles (OpenStreetMap's public servers are for light development use only)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
